# Secrets for the AudioNet server. Copy to /etc/audionet/audionet.env,
# chmod 640, owner root, group audionet. Never commit the real file.

# Must equal static-auth-secret in the coturn configuration.
# Generate with: openssl rand -hex 32
AUDIONET_TURN_SECRET=replace-with-a-long-random-secret

# The mail server password, with an [email] section in config.toml.
# AUDIONET_SMTP_PASSWORD=replace-with-the-mail-password

# Optional overrides of config.toml values:
# AUDIONET_PUBLIC_URL=https://audionet.example.com
# AUDIONET_BIND=127.0.0.1:8740
# RUST_LOG=audionet_server=info
